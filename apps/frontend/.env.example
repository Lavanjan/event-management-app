# Environment Configuration Example
# Copy this file to .env.local for local development
# Copy this file to .env.production for production builds

# API Configuration
VITE_API_BASE_URL=http://localhost:3002/api
VITE_API_TIMEOUT=30000

# Application Configuration
VITE_APP_NAME=Event Management System
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# Security Configuration
VITE_ENABLE_CSRF=true
VITE_ENABLE_REQUEST_LOGGING=true

# Feature Flags
VITE_ENABLE_PAYMENT_MODULE=true
VITE_ENABLE_ROLE_MANAGEMENT=true
VITE_ENABLE_ADVANCED_PERMISSIONS=true

# External Services
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_PAYPAL_CLIENT_ID=...

# Analytics (optional)
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Development Settings
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_DEBUG_MODE=true
