# ==============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and update the values for your production environment

# ==============================================
# APPLICATION SETTINGS
# ==============================================
NODE_ENV=production
BACKEND_PORT=3000
FRONTEND_PORT=80

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=event_booking

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here

# ==============================================
# JWT & SECURITY CONFIGURATION
# ==============================================
# IMPORTANT: Generate a strong, unique JWT secret for production
JWT_SECRET=your_super_secure_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
COOKIE_SECRET=your_secure_cookie_secret_here

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# ==============================================
# ADMIN USER CONFIGURATION
# ==============================================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourSecureAdminPassword123!

# ==============================================
# EMAIL CONFIGURATION (SMTP)
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ==============================================
# URL CONFIGURATION
# ==============================================
# Update these URLs to match your production domain
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com
VITE_API_URL=https://api.yourdomain.com/api
VITE_APP_NAME=Event Booking System

# ==============================================
# FEATURE FLAGS
# ==============================================
ENABLE_CORS=true
ENABLE_SWAGGER=false

# ==============================================
# SECURITY NOTES
# ==============================================
# 1. Never commit this file with real credentials to version control
# 2. Use strong, unique passwords for all services
# 3. Consider using environment-specific secrets management
# 4. Regularly rotate passwords and secrets
# 5. Use HTTPS in production
# 6. Set up proper firewall rules
# 7. Enable database backups
# 8. Monitor application logs
